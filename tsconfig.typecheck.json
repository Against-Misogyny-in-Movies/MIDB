{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true
	},
	"include": [
		".svelte-kit/ambient.d.ts",
		".svelte-kit/non-ambient.d.ts",
		".svelte-kit/types/**/$types.d.ts",
		"src/**/*.ts",
		"db/**/*.ts",
		"scripts/**/*.ts",
		"e2e-tests/**/*.ts",
		".storybook/**/*.ts",
		"*.config.ts"
	],
	"exclude": ["node_modules", "db/migrations"]
}
