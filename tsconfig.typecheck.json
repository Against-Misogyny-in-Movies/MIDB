{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true
	},
	"include": [
		"ambient.d.ts",
		"env.d.ts",
		"non-ambient.d.ts",
		".svelte-kit/ambient.d.ts",
		".svelte-kit/non-ambient.d.ts",
		".svelte-kit/types/**/$types.d.ts",
		"src/**/*.ts",
		"db/**/*.ts",
		"scripts/**/*.ts",
		"e2e-tests/**/*.ts",
		"*.config.ts"
	],
	"exclude": ["node_modules", ".svelte-kit/output", "db/migrations"]
}
