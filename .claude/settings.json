{
	"permissions": {
		"allow": [
			"Bash(bun install)",
			"Bash(bun install --frozen-lockfile)",
			"Bash(bun run check)",
			"Bash(bun run lint)",
			"Bash(bun run format)",
			"Bash(bun run test:unit *)",
			"Bash(bun run test:db)",
			"Bash(bun run build)",
			"Bash(bun run docs:index)",
			"Bash(bun run docs:section *)",
			"Bash(bun run commit:check *)",
			"Bash(bunx vitest run *)",
			"Bash(bunx vitest related *)"
		]
	},
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
					}
				]
			}
		]
	}
}
