{
  "name": "midb",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "scripts": {
    "dedup-svelte": "rm -rf node_modules/@sveltejs/vite-plugin-svelte/node_modules/svelte",
    "dev": "bun run dedup-svelte && vite dev",
    "dev:debug": "bun run dedup-svelte && export NODE_OPTIONS='--inspect' && vite dev",
    "build": "bun run dedup-svelte && vite build",
    "preview": "vite preview",
    "test": "bun run test:integration && npm run test:unit",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:integration": "playwright test",
    "test:unit": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "bun ./db/scripts/migrate.ts",
    "db:seed": "bun ./db/scripts/seed.ts"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.3.1",
    "@loom-io/fs": "^0.4.1",
    "@playwright/test": "latest",
    "@storybook/addon-svelte-csf": "^5.0.0",
    "@storybook/svelte": "^9.0.0",
    "@storybook/sveltekit": "^9.0.0",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.21.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/svelte": "^5.0.0",
    "@types/bun": "^1.0.0",
    "@types/jsdom": "latest",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "drizzle-kit": "^0.20.13",
    "eslint": "^8.28.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-storybook": "^0.11.0",
    "eslint-plugin-svelte": "^2.30.0",
    "jest-dom": "^4.0.0",
    "jsdom": "latest",
    "postcss": "^8.4.31",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^4.0.0",
    "storybook": "^9.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.4.1",
    "typescript": "^5.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "type": "module",
  "dependencies": {
    "@teamhanko/hanko-elements": "^0.10.0",
    "drizzle-orm": "^0.29.3",
    "jose": "^6.2.3",
    "marked": "^11.1.1",
    "nanoid": "^5.0.3",
    "nodemailer": "^6.9.7",
    "postgres": "^3.4.3",
    "remixicon": "^3.5.0",
    "rxjs": "^7.8.1"
  }
}
