{
	"name": "midb",
	"version": "0.0.1",
	"license": "Apache-2.0",
	"packageManager": "pnpm@10.28.0",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:debug": "export NODE_OPTIONS='--inspect' && vite dev",
		"build": "vite build",
		"preview": "pnpm build && wrangler dev --local --port 4173 --show-interactive-dev-session=false",
		"test": "pnpm test:integration && pnpm test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"typecheck": "svelte-kit sync && node node_modules/typescript7/bin/tsc -p tsconfig.typecheck.json",
		"lint": "prettier --check . && oxlint --type-aware --deny-warnings && eslint .",
		"lint:fix": "oxlint --type-aware --fix && eslint . --fix",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest --project unit",
		"test:db": "vitest run --project db",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"cf:types": "wrangler types --include-runtime=false --strict-vars=false --env-file /dev/null",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"db:sync:um": "node --env-file-if-exists=.env db/scripts/sync/sync-um.ts",
		"db:sync:bechdel": "node --env-file-if-exists=.env db/scripts/sync/sync-bechdel.ts",
		"db:sync:popularity": "node --env-file-if-exists=.env db/scripts/sync/sync-popularity.ts",
		"db:sync:all": "node --env-file-if-exists=.env db/scripts/sync/sync-all.ts",
		"db:backfill:tmdb": "node --env-file-if-exists=.env db/scripts/backfillTmdb.ts",
		"db:cleanup:orphans": "node --env-file-if-exists=.env db/scripts/cleanup-orphans.ts",
		"db:seed:admin": "node --env-file-if-exists=.env db/scripts/seedAdmin.ts",
		"commit:check": "node scripts/git/commit-message.ts",
		"docs:index": "node scripts/docs/index.ts",
		"docs:section": "node scripts/docs/index.ts section",
		"prepare": "node scripts/git/commit-message.ts --install"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261112.1",
		"@faker-js/faker": "^10.4.0",
		"@playwright/test": "^1.61.0",
		"@storybook/addon-svelte-csf": "^5.1.5",
		"@storybook/svelte": "^10.6.7",
		"@storybook/sveltekit": "^10.6.7",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/jest-dom": "^6.1.4",
		"@testing-library/svelte": "^5.4.2",
		"@types/jsdom": "^28.0.3",
		"@types/node": "^22",
		"@typescript-eslint/parser": "^8.60.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"jsdom": "^29.1.1",
		"oxlint": "1.93.0",
		"oxlint-tsgolint": "7.0.2006",
		"postcss": "^8.4.31",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.0.0",
		"storybook": "^10.6.7",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.0",
		"tslib": "^2.4.1",
		"typescript": "~6.0.3",
		"typescript7": "npm:typescript@7.0.2",
		"vite": "^8.3.8",
		"vitest": "^4.0.0",
		"wrangler": "^4.160.1",
		"zod": "^4.6.7"
	},
	"type": "module",
	"dependencies": {
		"@anthropic-ai/sdk": "1.8.0",
		"@better-auth/passkey": "1.7.21",
		"better-auth": "1.7.21",
		"drizzle-orm": "^0.45.2",
		"remixicon": "^4.9.1"
	},
	"pnpm": {
		"overrides": {
			"@anthropic-ai/sdk": "1.8.0",
			"@better-auth/passkey": "1.7.21",
			"@cloudflare/workers-types": "5.20261112.1",
			"@faker-js/faker": "10.5.0",
			"@playwright/test": "1.61.0",
			"@storybook/addon-svelte-csf": "5.1.5",
			"@storybook/svelte": "10.6.7",
			"@storybook/sveltekit": "10.6.7",
			"@sveltejs/adapter-cloudflare": "8.0.2",
			"@sveltejs/kit": "3.2.0",
			"@sveltejs/vite-plugin-svelte": "7.3.1",
			"@tailwindcss/vite": "4.3.1",
			"@testing-library/jest-dom": "6.9.1",
			"@testing-library/svelte": "5.4.2",
			"@typescript-eslint/parser": "8.61.1",
			"better-auth": "1.7.21",
			"drizzle-kit": "0.31.10",
			"drizzle-orm": "0.45.2",
			"eslint": "10.5.0",
			"eslint-plugin-svelte": "3.24.1",
			"oxlint": "1.93.0",
			"oxlint-tsgolint": "7.0.2006",
			"postcss": "8.5.15",
			"prettier": "3.8.4",
			"storybook": "10.6.7",
			"svelte": "5.57.3",
			"svelte-check": "4.7.8",
			"tailwindcss": "4.3.1",
			"tslib": "2.8.1",
			"vite": "8.3.8",
			"vitest": "4.1.9",
			"wrangler": "4.160.1",
			"zod": "4.6.7"
		},
		"onlyBuiltDependencies": [
			"esbuild",
			"workerd"
		]
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*",
		"#db/*": "./db/*",
		"#test/*": "./src/test/*"
	}
}
