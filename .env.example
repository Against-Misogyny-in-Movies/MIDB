# Copy to `.env`. Wrangler's local runtime reads it, so these are the Worker's secrets and vars in
# `pnpm dev`; production secrets are set with `wrangler secret put`. Nothing here is committed.

# Public values (also in wrangler.jsonc `vars`).
PUBLIC_ORIGIN=http://localhost:5173
PUBLIC_TMDB_API_URL=https://api.themoviedb.org
PUBLIC_TMDB_IMAGE_URL=/img/tmdb
# Turnstile on passkey sign-up. Empty skips the widget, so sign-up needs no network. To try it,
# use Cloudflare's documented always-passes test key, 1x00000000000000000000AA.
PUBLIC_TURNSTILE_SITE_KEY=

# Only for `--remote` on the db scripts (they write to the deployed D1 over the Cloudflare API).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Secrets. Each one left empty disables the feature that needs it.
TMDB_API_TOKEN=
DDD_API_KEY=
# Optional on localhost (Better Auth signs with a public default there); required anywhere else.
# Passkeys need no other secret. Google and Discord appear only when both of their values are set.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Comment moderation. Without a key a comment that passes the blocklist waits for a moderator.
ANTHROPIC_API_KEY=
TURNSTILE_SECRET_KEY=
# Extra blocklist terms (comma or newline separated), added to the public list in code.
MODERATION_EXTRA_TERMS=
# Set to 1 to publish comments that pass the blocklist when there is no key. Works only when PUBLIC_ORIGIN is localhost.
MODERATION_DEV_AUTO_APPROVE=
